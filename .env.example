# 取值范围 UI, PHONE, FASTAPI 
MODE="FASTAPI"

# 可选值：orca、deepseek、ollama
LLM_PROVIDER="orca"

LLM_API_KEY="sk-orca-YOUR_KEY"
LLM_BASE_URL="https://api.orcarouter.ai/v1"
LLM_MODEL="deepseek/deepseek-v4-flash-0731"
LLM_REASONING_EFFORT=""
LLM_EXTRA_BODY=""

# 切换 Provider 后，按需修改上面的统一配置。例如：
# LLM_PROVIDER="deepseek"
# LLM_API_KEY="你的 DeepSeek API Key"
# LLM_BASE_URL="https://api.deepseek.com"
# LLM_MODEL="deepseek-v4-flash"
# LLM_REASONING_EFFORT="high"
# LLM_EXTRA_BODY='{"thinking":{"type":"enabled"}}'
#
# LLM_PROVIDER="ollama"
# LLM_API_KEY="ollama"
# LLM_BASE_URL="http://localhost:11434/v1/"
# LLM_MODEL="qwen3.8-flash-next"

HF_ENDPOINT="https://hf-mirror.com"
